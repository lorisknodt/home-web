# Copy to /etc/home-web.env (chown root:homeweb, chmod 640). Never in Git.
HOMEWEB_TPY=/opt/home-web-house/house.tpy
# House files (default: next to the app in /opt/home-web, else the examples of the repository)
HOMEWEB_RULES=/opt/home-web-house/rules.json
HOMEWEB_HOUSE=/opt/home-web-house/house.json
HOMEWEB_PLAN_DEFAULT=/opt/home-web-house/plan_default.json
# Accounts: file managed with "python -m app.accounts" (see docs/INSTALL.md)
HOMEWEB_ACCOUNTS=/etc/home-web-accounts.json
# Language of the page and of the log (en or fr), time zone of the log
HOMEWEB_LANG=en
HOMEWEB_TZ=Europe/Brussels
HOMEWEB_POLL=1
# Length of a command pulse, in milliseconds (50 to 1000)
HOMEWEB_PULSE_MS=100
# Optional: allowed Tailscale accounts (see docs/INSTALL.md). Empty = any account of the tailnet + password.
HOMEWEB_TS_LOGINS=

# Controller (dedicated network, 2nd network card of the container); AMS Net ID = IP + .1.1 on a BX9000
PLC_NETID=192.168.100.10.1.1
PLC_IP=192.168.100.10
PLC_PORT=800
LOCAL_NETID=192.168.100.11.1.1
